{% import "rally.helpers" as rally %}
{
  "name": "logging-frozen-tier-queries-individual",
  "description": "Runs queries when indices are loaded in the frozen tier",
  "parameters": {
    "generate-data": false
  },
  "schedule": [
    {
      "name": "check-cluster-health",
      "operation": {
        "operation-type": "cluster-health",
        "index": "_all",
        "request-params": {
          "wait_for_status": "{{cluster_health | default('green')}}",
          "wait_for_no_relocating_shards": "true"
        },
        "retry-until-success": true
      }
    },
    {% for index_name in p_partial_indices %}
    {
      "name": {{index_name | tojson }},
      "operation": {
        "operation-type": "frozen-queries-runner",
        "clear_cache": true,
        "index_name": {{index_name | tojson}}
      },
      "iterations": 50
    }{{ ", " if not loop.last else "" }}
    {% endfor %}
  ]
}